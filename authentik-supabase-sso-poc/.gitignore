# Docker / Database Data (Critical to ignore to avoid committing DB files)
volumes/authentik/database/
volumes/authentik/redis/
volumes/authentik/media/
volumes/supabase/db/
# Keep custom-templates if any, but ignore standard media
!volumes/authentik/custom-templates/

# Ignore the actual db data files but keep the directories structure
volumes/authentik/database/*
!volumes/authentik/database/.keep
